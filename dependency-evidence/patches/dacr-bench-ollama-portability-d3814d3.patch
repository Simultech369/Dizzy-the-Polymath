From d3814d37f84e89084cfc334e95e3db10614400bb Mon Sep 17 00:00:00 2001
From: Simultech369 <265983039+Simultech369@users.noreply.github.com>
Date: Mon, 22 Jun 2026 06:51:34 -0400
Subject: [PATCH] make DACR runner portable for local Ollama

---
 README.md         |  22 +-
 package-lock.json | 566 ++++++++++++++++++++++++++++++++++++++++++++++
 package.json      |  16 ++
 src/evaluate.ts   |  25 +-
 src/run.ts        | 164 +++++++++-----
 src/types.ts      |   2 +
 tsconfig.json     |  12 +
 7 files changed, 750 insertions(+), 57 deletions(-)
 create mode 100644 package-lock.json
 create mode 100644 package.json
 create mode 100644 tsconfig.json

diff --git a/README.md b/README.md
index 159d62e..814b77e 100644
--- a/README.md
+++ b/README.md
@@ -20,6 +20,13 @@ npx tsx src/run.ts \
   --benchmark data/dacr_bench_v1.1_mini.json \
   --model sonnet --limit 5
 
+# Low-cost local smoke test (one challenge, one question)
+npx tsx src/run.ts \
+  --benchmark data/dacr_bench_v1.1_mini.json \
+  --runner http --endpoint http://localhost:11434/api/chat \
+  --model gemma3:4b --split synthetic \
+  --max-document-words 1800 --limit 1 --questions 1 --max-tokens 512
+
 # Run only real-document or synthetic challenges
 npx tsx src/run.ts \
   --benchmark data/dacr_bench_v1.1.json \
@@ -117,11 +124,15 @@ npx tsx src/run.ts \
 npx tsx src/run.ts \
   --benchmark data/dacr_bench_v1.1.json \
   --runner http \
-  --endpoint http://localhost:8000/v1/chat/completions \
-  --model Qwen/Qwen2.5-7B-Instruct \
+  --endpoint http://localhost:11434/v1/chat/completions \
+  --model qwen2.5-coder:7b \
   --output results/predictions_qwen7b.json
 ```
 
+The HTTP runner uses Node's built-in `fetch` and works on Windows, macOS, and
+Linux. The default endpoint is Ollama's OpenAI-compatible endpoint at
+`http://localhost:11434/v1/chat/completions`.
+
 ### Options
 | Flag | Default | Description |
 |------|---------|-------------|
@@ -131,8 +142,15 @@ npx tsx src/run.ts \
 | `--temperature` | 0.1 | Inference temperature |
 | `--timeout` | 120 | Seconds per challenge |
 | `--limit` | all | Max challenges to run |
+| `--questions` | all | Max questions per challenge for smoke tests |
+| `--max-tokens` | 4000 | Maximum completion tokens |
+| `--max-document-words` | all | Skip larger documents and try shortest first |
+| `--ollama-context` | 8192 | Context window for Ollama's native `/api/chat` route |
 | `--split` | all | `real`, `synthetic`, or `all` |
 
+For smoke results, pass the same `--split`, `--max-document-words`, `--limit`,
+and `--questions` filters to `evaluate.ts` that you used with `run.ts`.
+
 ## Evaluation Metrics
 
 ### Primary
