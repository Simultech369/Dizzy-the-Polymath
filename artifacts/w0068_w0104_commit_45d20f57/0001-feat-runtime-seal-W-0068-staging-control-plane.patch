+} from "./bounty_hunter_engine.mjs";
+
+export const JOB_BOARD_INGRESS_SCHEMA = "dizzy.job_board_ingress.v1";
+export const OPPORTUNITY_RECEIPT_SCHEMA = "dizzy.opportunity_receipt.v1";
+
