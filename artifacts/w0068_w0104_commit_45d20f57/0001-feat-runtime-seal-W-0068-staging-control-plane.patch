+    ? "COUNCIL_PASSED"
+    : "COUNCIL_REJECTED";
+
+  const payload = {
+    schema_version: SUBCOMMITTEE_VERDICT_SCHEMA,
+    topic_id: topicId,
+    timestamp: new Date().toISOString(),
